# Public DNS name. Point its A/AAAA record to the VPS before starting Caddy.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# Used only when the selected e-mail does not yet exist in the database.
# Generate with: openssl rand -base64 32
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters
